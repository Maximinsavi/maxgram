 <meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<script src="https://unpkg.com/parse/dist/parse.min.js"></script>

<script>
Parse.initialize(
"BHxYtdxdSPMSH5vXHVdKCVTBrxMBlbPLhz2p4CRc",
"88Fp770fFyWoBEXCljw9QhlaY6EPYcx9kR1sVpZV"
);

Parse.serverURL = "https://parseapi.back4app.com";
</script>


<style>

body{
margin:0;
font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto;
background:#fafafa;
}

/* HEADER */
.header{
height:55px;
background:white;
border-bottom:1px solid #ddd;
display:flex;
align-items:center;
justify-content:center;
font-weight:700;
}

/* POST CARD */
.post{
background:white;
margin-bottom:15px;
border-bottom:1px solid #eee;
}

.post-header{
display:flex;
align-items:center;
padding:10px;
}

.avatar{
width:35px;
height:35px;
border-radius:50%;
object-fit:cover;
margin-right:10px;
}

.username{
font-weight:600;
font-size:14px;
}

.post-img{
width:100%;
height:400px;
object-fit:cover;
background:#eee;
}

.post-body{
padding:10px;
}

.caption{
font-size:14px;
margin-bottom:10px;
color:#333;
}

/* BUTTON */
.like-btn{
background:none;
border:none;
font-weight:600;
color:#1877f2;
cursor:pointer;
padding:0;
}

.like-count{
font-size:13px;
color:#777;
margin-top:5px;
}

.empty{
text-align:center;
margin-top:40px;
color:#777;
}

</style>


<div class="header">
Accueil
</div>


<div id="feed"></div>


<script>

async function init(){

loadPosts();

}


async function loadPosts(){

var Post = Parse.Object.extend("Posts");
var query = new Parse.Query(Post);

query.include("owner");
query.descending("createdAt");
query.limit(50);

var posts = await query.find();

var feed = document.getElementById("feed");
feed.innerHTML = "";

if(posts.length === 0){
feed.innerHTML = "<div class='empty'>Aucune publication</div>";
return;
}

posts.forEach(function(post){

var owner = post.get("owner");
var image = post.get("image");

var avatar = owner.get("avatar")
? owner.get("avatar").url()
: "https://ui-avatars.com/api/?name=" + owner.get("username");

var div = document.createElement("div");

div.className = "post";

div.innerHTML = `

<div class="post-header">

<img class="avatar" src="${avatar}">

<div class="username">${owner.get("username")}</div>

</div>


<img class="post-img" src="${image.url()}">


<div class="post-body">

<div class="caption">${post.get("caption") || ""}</div>

<button class="like-btn">Like</button>

<div class="like-count">
${post.get("likes") || 0} likes
</div>

</div>

`;

feed.appendChild(div);

});

}


init();

</script>